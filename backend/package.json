{
  "name": "fundsroom-operations-api",
  "version": "1.0.0",
  "private": true,
  "description": "API for the FundsRoom Mini ERP + CRM Operations Portal.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:create": "tsx src/scripts/create-database.ts",
    "db:setup": "tsx src/scripts/setup-database.ts",
    "db:crm": "tsx src/scripts/setup-crm-engagement.ts",
    "db:crm-replies": "tsx src/scripts/setup-crm-replies.ts",
    "db:stock-requests": "tsx src/scripts/setup-stock-requests.ts",
    "db:notifications": "tsx src/scripts/setup-notifications.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:demo-history": "tsx src/scripts/seed-demo-history.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.23.2",
    "pdfkit": "^0.19.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
